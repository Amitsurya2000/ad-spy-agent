# docker-compose.yml env vars (see DEPLOY.md). Copy to .env on the server.

# Password for the Postgres container's `adspy` user (pick anything strong -
# this database is never exposed outside the Docker network).
POSTGRES_PASSWORD=change-me

# Without this, scraping still works but Gemini Creative DNA / Clone /
# Rewrite / Niche-Transform features are skipped/disabled.
GEMINI_API_KEY=your-gemini-key

# Shared password gating the whole dashboard (Basic Auth, see web/proxy.ts).
# Leave blank to leave the dashboard open.
DASHBOARD_PASSWORD=pick-a-shared-password

# Domain pointed (A record) at this server's IP - Caddy uses it to request
# and renew a Let's Encrypt certificate automatically.
DOMAIN=adspy.yourdomain.com
